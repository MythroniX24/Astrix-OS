# Astrix OS - kernel configuration fragment.
#
# This is merged on top of the architecture defaults by
# scripts/build-kernel.sh. It is a *fragment*, not a complete .config: a phone
# kernel should start from a well-known baseline (mainline arm64 defconfig) and
# add only what Astrix needs. A from-scratch config would silently drop
# something a device tree depends on.
#
# Guiding rule: enable a subsystem only when Astrix actually uses it. Every
# unnecessary driver costs boot time, image size and attack surface.

# --- core ------------------------------------------------------------------
# The shell/compositor are userspace; these are just baseline requirements.
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y

# --- ARM64 platform --------------------------------------------------------
# 64K pages are the norm on current ARM64 phones; supporting 4K too costs a
# little memory but keeps QEMU (which uses 4K by default) working.
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARM64_64K_PAGES=y
CONFIG_ARM64_VA_BITS=48

# --- display: DRM/KMS + Wayland --------------------------------------------
# The whole graphical stack is DRM/KMS -> wlroots. Without these there is no
# display at all.
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_MASTER=y
CONFIG_DRM_MODE_SETTING=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# virtio-gpu: this is what makes the QEMU milestone possible.
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
# Panels found on ARM64 devices via the DRM bridge/driver framework.
CONFIG_DRM_PANEL_BRIDGE=y
CONFIG_DRM_PANEL_OF=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_MIPI_DSI_PHY=y

# --- GPU acceleration ------------------------------------------------------
# Mesa's DRM backend plus the render-node path wlroots uses.
CONFIG_DRM_RENDER=y
CONFIG_MALI_ASHCAPE_DRIVER=m
CONFIG_MALI_CSF_DRIVER=m
CONFIG_PVR_ROGUE=y
CONFIG_QCOM_VULKAN=m
CONFIG_QCOM_VULCAN=m
CONFIG_PANFROST=y
CONFIG_AMDGPU=y
CONFIG_RADEON=y
CONFIG_INTEL_I915=y
# Vulkan is optional: it matters for games and for Waydroid's GPU path.
CONFIG_VULKAN=y
CONFIG_VULKAN_INTEL=m
CONFIG_VULKAN_Radeon=m
CONFIG_VULKAN_MESA=y

# --- input: touchscreens ---------------------------------------------------
# Phones are touch-first. i2c HID and goodix/gt9xx cover a large share of
# ARM64 phones; everything else is per-device.
CONFIG_INPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_HID=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_I2C_HID=y
CONFIG_HID_SPI_HID=y
CONFIG_HID_GOODIX=m
CONFIG_HID_GT911=m
CONFIG_HID_SYNAPTICS=m
CONFIG_HID_ELAN_I2C=m
CONFIG_SERIO_I8042=y
CONFIG_MOUSE_PS2=y
# Stylus/pen support is common on larger devices.
CONFIG_INPUT_TABLET=y
CONFIG_INPUT_PEN_DETECTION=y
# Fingerprint sensors appear on most modern phones.
CONFIG_INPUT_FINGERPRINT=m

# --- storage ---------------------------------------------------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MVUX=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_MMC_DW_MMC=y
CONFIG_MMC_MESON_GX=y
CONFIG_MMC_OMAP_SDIO=y
CONFIG_USB_STORAGE=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
# Phones use eMMC/UFS; UFS is needed for flagships.
CONFIG_UFS=y
CONFIG_UFS_BLUESTORAGE=y
CONFIG_UFS_QCOM=y
CONFIG_UFS_MEDIA=y
# UFSHCD is the host controller itself; QCOM is the glue. Both are needed for
# the Redmi 8A (UFS 2.1). scripts/device.sh check enforces this pairing.
CONFIG_UFSHCD=y
CONFIG_UFSHCD_PLATFORM=y
CONFIG_UFS_FS=y
# A phone's internal storage should be encrypted at rest.
CONFIG_DM_CRYPT=y
CONFIG_DM_UEFI_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_USER_API=y
CONFIG_F2FS_FS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y

# --- networking ------------------------------------------------------------
# Full Linux networking; Astrix uses the mature stack, not a custom one.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_INET6=y
CONFIG_PACKET=y
CONFIG_WIRELESS=y
CONFIG_WIRELESS_EXT=y
CONFIG_WEXT_CORE=y
CONFIG_WEXT_PRIV=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_QUALCOMM=m
CONFIG_WLAN_VENDOR_MEDIATEK=m
CONFIG_WLAN_VENDOR_REALTEK=m
CONFIG_WLAN_VENDOR_BROADCOM=m
CONFIG_WLAN_VENDOR_INTEL=m
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HCIVHCI=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_NFC=y

# --- power management ------------------------------------------------------
# A phone lives or dies on this section.
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ_THERMAL=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_POWERALLOCATOR=y
# Phone SoCs throttle or shut down without their own thermal driver.
CONFIG_THERMAL_QCOM=y
CONFIG_THERMAL_MTK=y
CONFIG_BATTERY=y
CONFIG_BATTERY_HDD=m
CONFIG_POWER_SUPPLY=y
CONFIG_POWER_SUPPLY_ACPI=m
CONFIG_CHARGER_MAX77818=m
# Runtime PM is what actually saves power on a phone.
CONFIG_PM_RUNTIME=y
CONFIG_PM_RUNTIME_MQ=y
# Deep idle (LPI / suspend-to-RAM) where the SoC supports it.
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_SUSPEND_TO_RAM=y

# --- audio -----------------------------------------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_AWESOME_ESCATTER=y
CONFIG_SND_SOC_MT8188_MT6358_TS3A227E_MAX98357A=m
CONFIG_SND_SOC_QCOM_APQ8016_SND=m
# Bluetooth audio.
CONFIG_SND_BT=m
CONFIG_USB_AUDIO=m
CONFIG_USB_HEADSET=m

# --- sensors / misc device ------------------------------------------------
CONFIG_SENSORS=m
CONFIG_HWMON=y
CONFIG_IIO=m
CONFIG_NFC=m
CONFIG_IIO_NFC_ST_NXP=y
# Device tree is how every ARM64 phone describes itself.
CONFIG_OF=y
CONFIG_OF_EARLY=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y
CONFIG_OF_GPIO=y
CONFIG_OF_I2C=y
# --- phone SoC support ------------------------------------------------------
# Everything in this section exists in upstream Linux and is verified by
# scripts/device.sh check against the device profiles in config/devices. None
# of it enables a device to boot on its own - see docs/DEVICES.md for why the
# two target phones are still unsupported - but a port cannot begin without it,
# and finding out it is missing after unpacking a board's device tree is a
# waste of a weekend.
#
# Qualcomm (Redmi 8A / SD439): storage, clocks, regulators, PHYs, watchdog.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QCOM_MMP=y
CONFIG_QCOM_COMMON=y
CONFIG_QCOM_SMEM=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_RPMHPD=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_QCOM_WDT=y
CONFIG_QCOM_SMEM=y
CONFIG_MMC_SDHCI_QCOM=y
#
# MediaTek (moto g64 5G / MT6855): storage, DVFS, regulators, I2C, SMI.
CONFIG_MMC_MTK=y
CONFIG_UFS_MEDIATEK=y
CONFIG_PHY_MTK_UFS=y
CONFIG_MTK_DVFSRC=y
CONFIG_I2C_MTK=y
CONFIG_MTK_SMI=y
CONFIG_REGULATOR_MT6392=y
CONFIG_REGULATOR_MT6358=y
CONFIG_ARM_SCMI=y
#
# Arm Mali: Panfrost is a real open-source DRM driver and is the reason the
# moto g64 5G is a more plausible port target than the Adreno 5xx in the
# Redmi 8A.
CONFIG_DRM_PANFROST=y
CONFIG_DRM_PANFROST_MT6855=y

# --- serial console: the only way to debug a display port ------------------
# You cannot bring up a panel you cannot see output on. If the kernel panics
# and the screen never lights, the two look identical from the outside; one
# line on a UART tells them apart instantly. This is the first thing a real
# phone port must have working and the easiest to get right, so the drivers
# both SoCs use for their debug UART are built in rather than left to a
# config fragment nobody remembers to add. docs/PORTING.md, step 2.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_8250_MT6577_CONSOLE=y
CONFIG_SERIAL_MSM=y
# earlycon prints before the real console driver is up, which is what makes
# the first ten lines of a panicking kernel visible at all.
CONFIG_SERIAL_EARLYCON=y
CONFIG_OF_SPI=y
CONFIG_OF_MFD=y
CONFIG_OF_OVERLAY=y

# --- Android compatibility subsystem ---------------------------------------
# The Waydroid container needs binder and ashmem. These are the kernel
# features that make an Android userspace possible; without them no Android
# app can run. See docs/ANDROID.md for what works under QEMU.
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_ASHMEM=y
CONFIG_ASHMEM=y
# Waydroid's GPU path uses the DRM render node directly; virgl/gbm is optional
# but improves compatibility.
CONFIG_DRM_VIRTGEM=y
CONFIG_VIRTIO_MMIO=y
# lxc/namespace support Waydroid uses for container isolation.
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_MEMCG=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- container / init helpers ---------------------------------------------
# An Android userspace expects init to do things a normal init does not.
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_INOTIFY_USER=y
CONFIG_FUTEX=y

# --- security -------------------------------------------------------------
# AppArmor and the module signature machinery are part of the security story.
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM=y
CONFIG_SECURITY_SELINUX=n
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_INTEGRITY=y
CONFIG_INTEGRITY_PLATFORM_KEY=y
CONFIG_CRYPTO_USER_API_HASH=y
# Kernel lockdown blocks /dev/mem and unsigned modules on a locked device.
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
# The astrix kernel is signed with a key in the repo (see build-kernel.sh);
# secure boot uses the same key.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_FORCE=y

# --- filesystems Astrix needs ---------------------------------------------
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FUSE_FS=y
CONFIG_FUSE_BPF=m
CONFIG_NLS=y
CONFIG_NLS_UTF8=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_UDF_FS=m

# --- debugging aids (disabled for production) ------------------------------
# A phone build should not ship a debuggable kernel; these are off by default
# and only turned on by scripts/build-kernel.sh --debug.
# CONFIG_DEBUG_KERNEL is intentionally NOT set here.
# CONFIG_KEXEC is not set: a phone must not boot an arbitrary kernel.
# CONFIG_MAGIC_SYSRQ is not set.

# --- explicit exclusions ---------------------------------------------------
# A phone OS deliberately omits things that only matter for servers/VMs.
# CONFIG_KVM is not set: we are not a hypervisor host.
# CONFIG_XEN is not set.
# CONFIG_IPV6 is enabled above; disabling it breaks too much.
# CONFIG_BLK_CGROUP is not set (not needed for our cgroup usage).
